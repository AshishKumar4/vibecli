{
	"name": "@cf-vibesdk/cli",
	"version": "0.0.1",
	"description": "CLI for VibeSDK - build and deploy fullstack apps with AI",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/AshishKumar4/vibecli"
	},
	"keywords": ["vibesdk", "cli", "ai", "cloudflare", "fullstack", "vibe coding", "vibe sdk", "agents"],
	"license": "MIT",
	"bin": {
		"vibecli": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "bun ./src/index.ts",
		"build": "rm -rf ./dist && bun ./scripts/build.ts",
		"build:standalone": "bun build ./src/index.ts --compile --outfile vibecli",
		"publish:all": "bun ./scripts/publish.ts",
		"test": "bun test",
		"typecheck": "tsc -p ./tsconfig.json --noEmit",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@cf-vibesdk/sdk": "^0.1.0",
		"@opentui/core": "^0.1.62",
		"@opentui/react": "^0.1.62",
		"react": "19"
	},
	"devDependencies": {
		"@types/react": "19",
		"bun-types": "^1.2.18",
		"typescript": "^5.9.3"
	}
}
