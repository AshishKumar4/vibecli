{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "ES2021.String", "DOM"],
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"types": ["bun-types"]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts"]
}
